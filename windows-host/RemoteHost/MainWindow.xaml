<Window x:Class="RemoteHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Remote Host"
        Width="1040" Height="700"
        MinWidth="800" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FontFamily="{StaticResource UiFontFamily}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titlebar: small red square icon + name, flat window controls (custom chrome
             per THEME.md / HostWindowQuiet.dc.html — no native title bar). -->
        <Border Grid.Row="0" Background="{StaticResource TitlebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Remote Host" Foreground="{StaticResource OnSurfaceMuted70Brush}" FontSize="12" FontWeight="Medium" Margin="9,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="&#8212;" Style="{StaticResource TitlebarButtonStyle}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="MaxRestoreButton" Content="&#9723;" Style="{StaticResource TitlebarButtonStyle}" FontSize="10" Click="MaxRestore_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Content="&#10005;" Style="{StaticResource TitlebarButtonStyle}" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LIVE ticker: real recent traffic, auto-scrolling horizontally. -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="LIVE" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                           Foreground="{StaticResource OnSurfaceMuted30Brush}" Margin="0,0,26,0" VerticalAlignment="Center"/>

                <Border Grid.Column="1" ClipToBounds="True">
                    <ItemsControl x:Name="TickerItemsControl" ItemsSource="{Binding TickerItems}" VerticalAlignment="Center">
                        <ItemsControl.RenderTransform>
                            <TranslateTransform x:Name="TickerTransform"/>
                        </ItemsControl.RenderTransform>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                           Foreground="{StaticResource OnSurfaceMuted42Brush}" Margin="0,0,26,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>

        <!-- Sidebar + content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="HOST v0.1" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                               Foreground="{StaticResource OnSurfaceMuted28Brush}" Margin="10,8,10,14"/>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavOverviewButton" Content="Overview" Style="{StaticResource NavButtonStyle}" Click="NavOverview_Click" Margin="0,0,0,2"/>
                        <Button x:Name="NavTrafficButton" Content="Traffic" Style="{StaticResource NavButtonStyle}" Click="NavTraffic_Click" Margin="0,0,0,2"/>
                        <Button x:Name="NavLaunchablesButton" Content="Launchables" Style="{StaticResource NavButtonStyle}" Click="NavLaunchables_Click" Margin="0,0,0,2"/>
                        <Button x:Name="NavPairingButton" Content="Pairing" Style="{StaticResource NavButtonStyle}" Click="NavPairing_Click" Margin="0,0,0,2"/>
                        <Button x:Name="NavGeneralButton" Content="General" Style="{StaticResource NavButtonStyle}" Click="NavGeneral_Click" Margin="0,0,0,2"/>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="10" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{Binding IsClientConnected, Converter={StaticResource ConnectionDotConverter}}"/>
                                <TextBlock Text="{Binding ListeningSummaryText}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="10"
                                           Foreground="{StaticResource OnSurfaceMuted60Brush}" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{Binding WsAddressText}" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5"
                                       Foreground="{StaticResource OnSurfaceMuted30Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Content column: stat row (always visible) + selected pane -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Stat row: one real, live-updating set of values (no fake alternating datasets). -->
                <Grid Grid.Row="0" Background="{StaticResource BgBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="18,16" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,1">
                        <StackPanel>
                            <TextBlock Text="CLIENT" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                                       Foreground="{StaticResource OnSurfaceMuted30Brush}"/>
                            <TextBlock Text="{Binding ClientStatusText}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="18"
                                       Foreground="{Binding IsClientConnected, Converter={StaticResource BoolToAccentBrushConverter}}"
                                       Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="18,16" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,1">
                        <StackPanel>
                            <TextBlock Text="COMMANDS HANDLED" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                                       Foreground="{StaticResource OnSurfaceMuted30Brush}"/>
                            <TextBlock Text="{Binding CommandsHandledCount}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="18"
                                       Foreground="{StaticResource OnSurfaceBrush}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Padding="18,16" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,1">
                        <StackPanel>
                            <TextBlock Text="UPTIME" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                                       Foreground="{StaticResource OnSurfaceMuted30Brush}"/>
                            <TextBlock Text="{Binding UptimeText}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="18"
                                       Foreground="{StaticResource OnSurfaceBrush}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Padding="18,16" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="REJECTED" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="9.5"
                                       Foreground="{StaticResource OnSurfaceMuted30Brush}"/>
                            <TextBlock Text="{Binding RejectedCount}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="SemiBold" FontSize="18"
                                       Foreground="{StaticResource OnSurfaceBrush}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Pane area -->
                <Grid Grid.Row="1" Margin="30,26">

                    <!-- Overview pane: static descriptive/marketing content. -->
                    <ScrollViewer x:Name="OverviewPanel" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel MaxWidth="520" Margin="0,0,0,26">
                                <TextBlock Text="Control this PC from your phone" Foreground="{StaticResource OnSurfaceBrush}"
                                           FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="Everything runs on your own network. The host executes commands locally and never sends your screen, files or keystrokes anywhere."
                                           Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel>
                                <!-- Row 1: text left, visual right -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Reach the volume without reaching the laptop" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="System mixer level, mute and 5-point nudges — applied instantly, echoed back so the phone never lies about state."
                                                       FontSize="12" Foreground="{StaticResource OnSurfaceMuted45Brush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="payload 8 B · ack required" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                                       Foreground="{StaticResource OnSurfaceMuted28Brush}" Margin="0,11,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Height="96" CornerRadius="10" Background="{StaticResource HatchBrush}" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1">
                                            <TextBlock Text="MIXER SCREENSHOT" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceMuted30Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Row 2: mirrored — visual left, text right -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Height="96" CornerRadius="10" Background="{StaticResource HatchBrush}" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1">
                                            <TextBlock Text="DISPLAY SCREENSHOT" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceMuted30Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Dim the room from the sofa" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Panel brightness on internal and DDC-capable external displays, one slider, no driver panel."
                                                       FontSize="12" Foreground="{StaticResource OnSurfaceMuted45Brush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="payload 8 B · ddc/ci" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                                       Foreground="{StaticResource OnSurfaceMuted28Brush}" Margin="0,11,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 3: text left, visual right -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Start what you need before you sit down" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="Six launchables you choose here, exposed as tiles on the phone. Paths stay on this machine."
                                                       FontSize="12" Foreground="{StaticResource OnSurfaceMuted45Brush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                            <TextBlock Text="payload 6 B · exec local" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"
                                                       Foreground="{StaticResource OnSurfaceMuted28Brush}" Margin="0,11,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Height="96" CornerRadius="10" Background="{StaticResource HatchBrush}" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1">
                                            <TextBlock Text="TILES SCREENSHOT" FontFamily="{StaticResource MonoFontFamily}" FontSize="9.5" FontWeight="Medium"
                                                       Foreground="{StaticResource OnSurfaceMuted30Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Traffic pane: real message log, newest first, with a real timing column. -->
                    <Grid x:Name="TrafficPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Watch every command land" Foreground="{StaticResource OnSurfaceBrush}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Raw socket traffic, newest first. Rejected peers are logged with a reason."
                                       Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LogEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,11" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76"/>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="64"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted28Brush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Level, Converter={StaticResource LogLevelToLabelConverter}}"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" FontWeight="Medium"
                                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5"
                                                           Foreground="{StaticResource OnSurfaceMuted75Brush}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding ElapsedMs, Converter={StaticResource ElapsedMsToStringConverter}}"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted35Brush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Launchables pane: same CRUD as before, reskinned. -->
                    <Grid x:Name="LaunchablesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Decide what the phone can launch" Foreground="{StaticResource OnSurfaceBrush}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="These become tiles in the Launch tab, in this order."
                                       Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AppShortcuts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7" Background="{StaticResource HatchBrush}"
                                                        BorderBrush="{StaticResource BorderStrong10Brush}" BorderThickness="1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Tag}" Foreground="{StaticResource OnSurfaceMuted55Brush}" FontFamily="{StaticResource MonoFontFamily}"
                                                               FontWeight="Medium" FontSize="9.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource OnSurfaceBrush}" FontSize="12.5"
                                                           VerticalAlignment="Center" Margin="14,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Path}" Foreground="{StaticResource OnSurfaceMuted35Brush}"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="remove" Tag="{Binding Id}" Style="{StaticResource LinkButtonStyle}"
                                                        Click="RemoveShortcut_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppNameTextBox" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Shortcut name"/>
                            <TextBox x:Name="AppPathTextBox" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Full path to .exe or shortcut"/>
                            <Button Grid.Column="4" Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseAppPath_Click"/>
                            <Button Grid.Column="6" Content="Add" Style="{StaticResource PrimaryButtonStyle}" Click="AddShortcut_Click"/>
                        </Grid>
                    </Grid>

                    <!-- Pairing pane: same QR/token functionality, reskinned. -->
                    <Grid x:Name="PairingPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,22">
                            <TextBlock Text="Pair in one scan" Foreground="{StaticResource OnSurfaceBrush}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="The code carries address, port and token. Peers outside this subnet are refused."
                                       Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Width="212" Height="212" CornerRadius="14" Background="White" Padding="16" VerticalAlignment="Top">
                                <Image Source="{Binding QrImage}" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Width="260" Margin="24,0,0,0">
                                <Border CornerRadius="12" BorderBrush="{StaticResource Border07Brush}" BorderThickness="1" Padding="16" Margin="0,0,0,11">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="address" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted32Brush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding LocalIp}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="port" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted32Brush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Port}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="token" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted32Brush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="{Binding Token}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="subnet lock" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource OnSurfaceMuted32Brush}" HorizontalAlignment="Left"/>
                                            <TextBlock Text="on" FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5" Foreground="{StaticResource AccentLightBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Content="Rotate token &amp; regenerate" Style="{StaticResource PrimaryButtonStyle}" Click="RotateToken_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- General pane: real settings not present in the mock (deliberate addition). -->
                    <Grid x:Name="GeneralPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="General" Foreground="{StaticResource OnSurfaceBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <StackPanel Grid.Row="1">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start on login" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Launch Remote Host automatically when you sign in" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartOnLogin}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Minimize to tray on close" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Closing this window keeps Remote Host running in the tray" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Allow input simulation" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Reserved for a future release (touchpad / keyboard control)" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AllowInputSimulation}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Listening" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13.5"/>
                                        <TextBlock Text="Stop accepting new phone connections without closing the app" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding Listening, Converter={StaticResource ListeningLabelConverter}}"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="ToggleListening_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
