<Window x:Class="RemoteHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Host"
        Width="920" Height="640"
        MinWidth="760" MinHeight="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFontFamily}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,24,20,20">
                    <TextBlock Text="Remote Host" Foreground="{StaticResource OnSurfaceBrush}" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="{Binding MachineName}" Foreground="{StaticResource OnSurfaceMuted45Brush}"
                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button x:Name="NavStatusButton" Content="Status" Style="{StaticResource NavButtonStyle}" Click="NavStatus_Click" Margin="0,0,0,4"/>
                    <Button x:Name="NavAppsButton" Content="App shortcuts" Style="{StaticResource NavButtonStyle}" Click="NavApps_Click" Margin="0,0,0,4"/>
                    <Button x:Name="NavPairingButton" Content="Pairing" Style="{StaticResource NavButtonStyle}" Click="NavPairing_Click" Margin="0,0,0,4"/>
                    <Button x:Name="NavGeneralButton" Content="General" Style="{StaticResource NavButtonStyle}" Click="NavGeneral_Click" Margin="0,0,0,4"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="12,10,12,16" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding IsClientConnected, Converter={StaticResource ConnectionDotConverter}}"/>
                            <TextBlock Text="{Binding ClientStatusText}" Foreground="{StaticResource OnSurfaceMuted45Brush}"
                                       FontSize="11" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalIp}" Foreground="{StaticResource AccentTextBrush}"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Margin="28">

            <!-- Status pane -->
            <Grid x:Name="StatusPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Status" Foreground="{StaticResource OnSurfaceBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CONNECTED CLIENT" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClientStatusText}" Foreground="{StaticResource OnSurfaceBrush}" FontSize="16" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Ellipse Grid.Column="1" Width="10" Height="10" VerticalAlignment="Top"
                                 Fill="{Binding IsClientConnected, Converter={StaticResource ConnectionDotConverter}}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="VOLUME" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Foreground="{StaticResource AccentTextBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="18" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding Volume, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,0"
                                         Foreground="{StaticResource AccentStartBrush}" Background="#14ffffff" BorderThickness="0"/>
                            <TextBlock Text="Muted" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,8,0,0"
                                       Visibility="{Binding Muted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="BRIGHTNESS" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding BrightnessValue, StringFormat={}{0}%}" Foreground="{StaticResource OnSurfaceBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="18" HorizontalAlignment="Right"/>
                            </Grid>
                            <ProgressBar Value="{Binding BrightnessValue, Mode=OneWay}" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,0"
                                         Foreground="{StaticResource OnSurfaceBrush}" Background="#14ffffff" BorderThickness="0"/>
                            <TextBlock Text="Not supported on this display" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="0,8,0,0"
                                       Visibility="{Binding BrightnessSupported, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Foreground="{StaticResource OnSurfaceMuted38Brush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="16,14,16,8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <ItemsControl ItemsSource="{Binding LogEntries}" Margin="16,0,16,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{StaticResource OnSurfaceMuted38Brush}"
                                                       FontSize="11" Width="70"/>
                                            <TextBlock Text="{Binding Message}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Apps pane -->
            <Grid x:Name="AppsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="App shortcuts" Foreground="{StaticResource OnSurfaceBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADD SHORTCUT" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AppNameTextBox" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Shortcut name"/>
                            <TextBox x:Name="AppPathTextBox" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" ToolTip="Full path to .exe or shortcut"/>
                            <Button Grid.Column="4" Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Click="BrowseAppPath_Click"/>
                            <Button Grid.Column="6" Content="Add" Style="{StaticResource PrimaryButtonStyle}" Click="AddShortcut_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AppShortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="14" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentGradientBrush}">
                                                <TextBlock Text="{Binding Tag}" Foreground="White" FontWeight="Bold" FontSize="11"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource OnSurfaceBrush}" FontSize="13"/>
                                                <TextBlock Text="{Binding Path}" Foreground="{StaticResource OnSurfaceMuted45Brush}"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Remove" Tag="{Binding Id}" Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="RemoveShortcut_Click" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Pairing pane -->
            <Grid x:Name="PairingPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Pairing" Foreground="{StaticResource OnSurfaceBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <Grid Grid.Row="1" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Width="240" Height="240" VerticalAlignment="Top">
                        <Image Source="{Binding QrImage}" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="HOST ADDRESS" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding LocalIp}" Foreground="{StaticResource OnSurfaceBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="16" Margin="0,6,0,0"/>

                                <TextBlock Text="PORT" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding Port}" Foreground="{StaticResource OnSurfaceBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="16" Margin="0,6,0,0"/>

                                <TextBlock Text="PAIRING TOKEN" Foreground="{StaticResource OnSurfaceMuted38Brush}" FontSize="10" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <TextBlock Text="{Binding Token}" Foreground="{StaticResource AccentTextBrush}"
                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="16" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Rotate token" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Click="RotateToken_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- General pane -->
            <Grid x:Name="GeneralPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="General" Foreground="{StaticResource OnSurfaceBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start on login" Foreground="{StaticResource OnSurfaceBrush}" FontSize="14"/>
                                <TextBlock Text="Launch Remote Host automatically when you sign in" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartOnLogin}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimize to tray on close" Foreground="{StaticResource OnSurfaceBrush}" FontSize="14"/>
                                <TextBlock Text="Closing this window keeps Remote Host running in the tray" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding MinimizeToTrayOnClose}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Allow input simulation" Foreground="{StaticResource OnSurfaceBrush}" FontSize="14"/>
                                <TextBlock Text="Reserved for a future release (touchpad / keyboard control)" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding AllowInputSimulation}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Listening" Foreground="{StaticResource OnSurfaceBrush}" FontSize="14"/>
                                <TextBlock Text="Stop accepting new phone connections without closing the app" Foreground="{StaticResource OnSurfaceMuted45Brush}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{Binding Listening, Converter={StaticResource ListeningLabelConverter}}"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="ToggleListening_Click" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
